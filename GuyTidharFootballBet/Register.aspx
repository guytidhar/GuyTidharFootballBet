<%@ Page Title="הרשמה" Language="C#" MasterPageFile="~/MasterPage.master" AutoEventWireup="true" CodeFile="Register.aspx.cs" Inherits="Register" %>
<asp:Content ID="c1" ContentPlaceHolderID="head" runat="server"><script type="text/javascript">
function checkAll(){var ok=true; clearErrors(); if(!checkText('firstName','firstErr',2,'שם פרטי'))ok=false;if(!checkText('lastName','lastErr',2,'שם משפחה'))ok=false;if(!checkText('userName','userErr',4,'שם משתמש'))ok=false;if(!checkText('nickName','nickErr',2,'כינוי'))ok=false;var p=document.getElementById('password').value;if(p.length<4){document.getElementById('passErr').innerHTML='הסיסמה חייבת להכיל לפחות 4 תווים';ok=false;}if(!document.getElementById('agree').checked){document.getElementById('agreeErr').innerHTML='יש לאשר שימוש במטבעות וירטואליים';ok=false;}return ok;}
function checkText(id,err,min,label){var v=document.getElementById(id).value;if(v.length<min){document.getElementById(err).innerHTML=label+' חייב להכיל לפחות '+min+' תווים';return false;}return true;}
function clearErrors(){var a=['firstErr','lastErr','userErr','passErr','nickErr','agreeErr'];for(var i=0;i<a.length;i++)document.getElementById(a[i]).innerHTML='';}
</script></asp:Content><asp:Content ID="c2" ContentPlaceHolderID="MainContent" runat="server"><h1>הרשמת משתמש חדש</h1><table class="formTable"><tr><td>שם פרטי</td><td><input id="firstName" name="firstName" type="text" /></td><td id="firstErr" class="errorCell"></td></tr><tr><td>שם משפחה</td><td><input id="lastName" name="lastName" type="text" /></td><td id="lastErr" class="errorCell"></td></tr><tr><td>שם משתמש</td><td><input id="userName" name="userName" type="text" /></td><td id="userErr" class="errorCell"></td></tr><tr><td>סיסמה</td><td><input id="password" name="password" type="password" /></td><td id="passErr" class="errorCell"></td></tr><tr><td>כינוי</td><td><input id="nickName" name="nickName" type="text" /></td><td id="nickErr" class="errorCell"></td></tr><tr><td>ליגות שמעניינות אותי</td><td><label><input type="checkbox" name="interest" value="England" /> אנגלית</label> <label><input type="checkbox" name="interest" value="Spain" /> ספרדית</label></td><td></td></tr><tr><td colspan="2"><label><input id="agree" type="checkbox" /> אני מאשר שהמטבעות באתר וירטואליים בלבד</label></td><td id="agreeErr" class="errorCell"></td></tr><tr><td colspan="3" align="center"><input class="button" type="submit" onclick="return checkAll();" value="הרשמה" /></td></tr></table><div class="message"><%= st %></div></asp:Content>