<%@ Page Title="הרשמה" Language="C#" MasterPageFile="~/MasterPage.master" AutoEventWireup="true" CodeFile="Register.aspx.cs" Inherits="Register" %><asp:Content ID="a" ContentPlaceHolderID="head" runat="server"><script>function checkAll(){var ids=['firstName','lastName','userName','password','nickName'];for(var i=0;i<ids.length;i++){if(document.getElementById(ids[i]).value.length<2){alert('יש למלא את כל השדות');return false;}}return true;}</script></asp:Content><asp:Content ID="b" ContentPlaceHolderID="MainContent" runat="server"><h1>הרשמת משתמש חדש</h1><table class="formTable"><tr><td>שם פרטי</td><td><input id="firstName" name="firstName" type="text"/></td></tr><tr><td>שם משפחה</td><td><input id="lastName" name="lastName" type="text"/></td></tr><tr><td>שם משתמש</td><td><input id="userName" name="userName" type="text"/></td></tr><tr><td>סיסמה</td><td><input id="password" name="password" type="password"/></td></tr><tr><td>כינוי</td><td><input id="nickName" name="nickName" type="text"/></td></tr><tr><td>תחומי עניין</td><td><label><input type="checkbox"/> אנגליה</label> <label><input type="checkbox"/> ספרד</label></td></tr><tr><td colspan="2"><input class="button" onclick="return checkAll();" type="submit" value="הרשמה"/></td></tr></table><div class="message"><%=st%></div></asp:Content>