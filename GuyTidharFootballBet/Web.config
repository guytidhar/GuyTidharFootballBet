<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="FootballBetConnectionString"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\FootballBetDB.mdf;Integrated Security=True;Connect Timeout=30"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" requestValidationMode="2.0" />
	  <globalization
         requestEncoding="utf-8"
         responseEncoding="utf-8"
         fileEncoding="utf-8"
         culture="he-IL"
         uiCulture="he-IL" />
  </system.web>
</configuration>