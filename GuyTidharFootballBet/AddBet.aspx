<%@ Page Title="ביצוע הימור" Language="C#" MasterPageFile="~/MasterPage.master" AutoEventWireup="true" CodeFile="AddBet.aspx.cs" Inherits="AddBet" %><asp:Content ID="c1" ContentPlaceHolderID="head" runat="server"><script type="text/javascript">function checkBet(){document.getElementById('betErr').innerHTML='';var n=document.getElementById('betCoins').value;if(n=='' || isNaN(n) || parseInt(n)<=0){document.getElementById('betErr').innerHTML='יש להזין מספר מטבעות חיובי';return false;}return true;}</script></asp:Content><asp:Content ID="c2" ContentPlaceHolderID="MainContent" runat="server"><h1>ביצוע הימור חדש</h1><table class="formTable"><tr><td>בחירת משחק</td><td><select name="gameId"><%= gameOptions %></select></td></tr><tr><td>בחירת קבוצה</td><td><label><input type="radio" name="side" value="A" checked="checked" /> קבוצה א׳</label> <label><input type="radio" name="side" value="B" /> קבוצה ב׳</label></td></tr><tr><td>כמות מטבעות</td><td><input id="betCoins" name="betCoins" type="text" /></td><td id="betErr" class="errorCell"></td></tr><tr><td colspan="3" align="center"><input class="button" type="submit" onclick="return checkBet();" value="שמירת ההימור" /></td></tr></table><div class="message"><%= st %></div></asp:Content>