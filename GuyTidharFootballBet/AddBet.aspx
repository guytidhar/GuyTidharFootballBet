<%@ Page Title="ביצוע הימור" Language="C#" MasterPageFile="~/MasterPage.master" AutoEventWireup="true" CodeFile="AddBet.aspx.cs" Inherits="AddBet" %><asp:Content ID="a" ContentPlaceHolderID="head" runat="server"><script><%=GamesScript%>function loadGames(){var d=document.getElementById('gameDate').value,g=document.getElementById('gameId');g.options.length=0;g.options.add(new Option('בחר משחק',''));for(var i=0;i<games.length;i++)if(games[i].date==d)g.options.add(new Option(games[i].a+' נגד '+games[i].b,games[i].id));loadTeams();}function loadTeams(){var id=document.getElementById('gameId').value,box=document.getElementById('teams');box.innerHTML='';for(var i=0;i<games.length;i++)if(games[i].id==id)box.innerHTML='<label><input type="radio" name="betClubId" value="'+games[i].aid+'"/> '+games[i].a+'</label> &nbsp; <label><input type="radio" name="betClubId" value="'+games[i].bid+'"/> '+games[i].b+'</label>';}function checkBet(){var n=document.getElementById('betCoins').value;if(document.getElementById('gameId').value==''||!document.querySelector('input[name=betClubId]:checked')||isNaN(n)||parseInt(n)<=0){alert('יש לבחור תאריך, משחק, קבוצה וכמות מטבעות תקינה');return false;}return true;}</script></asp:Content><asp:Content ID="b" ContentPlaceHolderID="MainContent" runat="server"><h1>ביצוע הימור חדש</h1><table class="formTable"><tr><td>תאריך המשחק</td><td><select id="gameDate" name="gameDate" onchange="loadGames();"><option value="">בחר תאריך</option><%=DateOptions%></select></td></tr><tr><td>בחירת משחק</td><td><select id="gameId" name="gameId" onchange="loadTeams();"><option value="">בחר משחק</option></select></td></tr><tr><td>בחירת קבוצה</td><td id="teams">יש לבחור משחק תחילה</td></tr><tr><td>כמות מטבעות</td><td><input id="betCoins" name="betCoins" type="text"/></td></tr><tr><td colspan="2"><input class="button" onclick="return checkBet();" type="submit" value="שמירת ההימור"/></td></tr></table><div class="message"><%=st%></div></asp:Content>